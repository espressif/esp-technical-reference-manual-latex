%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%% PIE instruction encoding diagram helpers %%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Column widths are approximate bit-field size classes for Format tables
% in 03-PIE-latest/tables/pie_instruction__*.tex.
%
% Note: Shared TRM preamble already defines R[1] for ragged-right fixed-width
% columns (e.g. R{4cm}). Use H for the 5-bit class to avoid that clash.
% ECO5 instruction Format tables also use V (5-bit) and U (wide).

%1bit
\newcolumntype{I}{>{\centering\arraybackslash}p{0.18in}}
%2bit
\newcolumntype{W}{>{\centering\arraybackslash}p{0.36in}}
%3bit
\newcolumntype{F}{>{\centering\arraybackslash}p{0.54in}}
%4bit
\newcolumntype{Y}{>{\centering\arraybackslash}p{0.72in}}
%5bit (was R in module 00-shared)
\newcolumntype{H}{>{\centering\arraybackslash}p{0.9in}}
%5bit alias used by ECO5 Format tables
\newcolumntype{V}{>{\centering\arraybackslash}p{0.9in}}
%6bit
\newcolumntype{S}{>{\centering\arraybackslash}p{1.08in}}
%7bit
\newcolumntype{O}{>{\centering\arraybackslash}p{0.6in}}
%8bit
\newcolumntype{E}{>{\centering\arraybackslash}p{1.24in}}
%9bit
\newcolumntype{T}{>{\centering\arraybackslash}p{1.4in}}
%10bit
\newcolumntype{M}{>{\centering\arraybackslash}p{1.58in}}

\newcolumntype{K}{>{\centering\arraybackslash}p{2.66in}}
% wide field used by ECO5 Format tables
\newcolumntype{U}{>{\centering\arraybackslash}p{3.6in}}

\newcommand{\insbit}[1]{\mbox{\scriptsize #1}}
\newcommand{\insbitrange}[2]{~\insbit{#1} \hfill \insbit{#2}~}


